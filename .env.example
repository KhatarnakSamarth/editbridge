# EditBridge Supabase PostgreSQL Database Configuration
# In your Supabase Dashboard: Go to Project Settings -> Database -> Connection string -> URI
# Recommended: Mode = Session (port 5432) or Transaction (port 6543)

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional direct connection (if using Transaction pooler with pgBouncer on port 6543):
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
